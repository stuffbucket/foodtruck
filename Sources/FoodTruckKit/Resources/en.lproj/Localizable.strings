"summary.clean" = "Everything is where it should be";
"summary.hint" = "Run `foodtruck converge` to fix what can be fixed.";
"fault.detail.hint" = "FOODTRUCK_DEBUG=1 shows the raw output.";
"findings.more.one" = "1 more";
"findings.more.other" = "%{count} more";

"summary.drift.one" = "1 needs attention";
"summary.drift.other" = "%{count} need attention";
"summary.blocked.one" = "1 waiting";
"summary.blocked.other" = "%{count} waiting";
"summary.failed.one" = "1 failed";
"summary.failed.other" = "%{count} failed";
/* Separator between clauses in a list. Some languages do not use a comma. */
"list.separator" = ", ";
"recipe.customised" = "Customised";
"recipe.customised.help" = "You have edited this recipe. FoodTruck will leave your version alone.";
"setup.needed" = "FoodTruck has not finished setting itself up on this Mac.";
"setup.needed.remedy" = "Run `foodtruck converge` once. It only writes inside FoodTruck's own folder.";
"summary.nothingToFix" = "Nothing needs your attention";
"summary.proven.one" = "1 check passed";
"summary.proven.other" = "%{count} checks passed";
"summary.vacuous.one" = "1 proved nothing";
"summary.vacuous.other" = "%{count} proved nothing";
"check.vacuous" = "Nothing was declared, so this proved nothing.";
"check.passed" = "Passed";
"check.failed" = "Not yet";
"detail.checked" = "What FoodTruck checked";
